# CrossTax AI — Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Application
ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database (SQLite for local dev, asyncpg for prod)
DATABASE_URL=sqlite+aiosqlite:///./crosstax.db
# DATABASE_URL=postgresql+asyncpg://crosstax:crosstax@localhost:5432/crosstax
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# Optional CRS remediation agent via Alibaba Cloud Bailian (Qwen)
# Only requests with include_guidance=true call AI. Fill either key below, then restart.
RULE_AI_ENABLED=true
RULE_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RULE_AI_API_KEY=
# Alternative standard Bailian key; a non-empty RULE_AI_API_KEY takes precedence.
DASHSCOPE_API_KEY=
# General-purpose default; override with an available model ID/version for your deployment.
RULE_AI_MODEL=qwen-plus
RULE_AI_TIMEOUT_SECONDS=8
RULE_AI_MAX_CONCURRENCY=2
# Shared retry budget across all agent rounds; set 0 to disable automatic retries.
RULE_AI_MAX_RETRIES=1
# For a workspace endpoint, copy the complete compatible-mode base URL from your Bailian console.
# API Key, endpoint region and model access must belong to the same region.
