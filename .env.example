# CrossTax AI — Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Application
ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database (SQLite for local dev, asyncpg for prod)
DATABASE_URL=sqlite+aiosqlite:///./crosstax.db
# DATABASE_URL=postgresql+asyncpg://crosstax:crosstax@localhost:5432/crosstax
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# Optional CRS remediation agent (OpenAI-compatible Chat Completions endpoint)
# Default disabled; include_guidance=true falls back to deterministic hints until configured.
RULE_AI_ENABLED=false
RULE_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RULE_AI_API_KEY=
RULE_AI_MODEL=
RULE_AI_TIMEOUT_SECONDS=8
RULE_AI_MAX_CONCURRENCY=2
