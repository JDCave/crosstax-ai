# CrossTax AI — Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Application
ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database (SQLite for local dev, asyncpg for prod)
DATABASE_URL=sqlite+aiosqlite:///./crosstax.db
# DATABASE_URL=postgresql+asyncpg://crosstax:crosstax@localhost:5432/crosstax
# ADR-010: 每人 ≤ 3 连接且禁止溢出（组委会 PG 总连接上限 30，4 人团队）
DATABASE_POOL_SIZE=2
# API 2 + independent validation worker 1 = 3 connections maximum.
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# Optional CRS remediation agent via Alibaba Cloud Bailian (Qwen)
# Only requests with include_guidance=true call AI. Fill either key below, then restart.
RULE_AI_ENABLED=true
RULE_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RULE_AI_API_KEY=
# Alternative standard Bailian key; a non-empty RULE_AI_API_KEY takes precedence.
DASHSCOPE_API_KEY=
# General-purpose default; override with an available model ID/version for your deployment.
RULE_AI_MODEL=qwen-plus
RULE_AI_TIMEOUT_SECONDS=8
RULE_AI_MAX_CONCURRENCY=2
# Shared retry budget across all agent rounds; set 0 to disable automatic retries.
RULE_AI_MAX_RETRIES=1
# For a workspace endpoint, copy the complete compatible-mode base URL from your Bailian console.
# API Key, endpoint region and model access must belong to the same region.

# Durable rule-validation tasks (API and worker must share the same keys/database/build)
# Generate a Fernet key locally; never commit actual keys. First key encrypts; old keys decrypt.
RULE_TASK_ENCRYPTION_KEYS=[]
RULE_TASK_CAPACITY=100
RULE_TASK_TIMEOUT_SECONDS=30
RULE_TASK_RETENTION_SECONDS=86400
RULE_TASK_LEASE_SECONDS=5
RULE_TASK_HEARTBEAT_SECONDS=1
RULE_TASK_MAX_ATTEMPTS=3

# Background PDF generation: same worker process and database pool as validation
RULE_REPORT_TIMEOUT_SECONDS=15
RULE_REPORT_LEASE_SECONDS=20
RULE_REPORT_HEARTBEAT_SECONDS=3
RULE_REPORT_MAX_ATTEMPTS=3
