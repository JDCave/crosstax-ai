# ============================================
# CrossTax AI - Git Ignore
# ============================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
ENV/
env/

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Environment variables (keep .env.example, ignore actual .env)
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Data & outputs (generated at runtime)
data/
outputs/
*.db
*.sqlite
*.sqlite3

# Docker
docker-compose.override.yml

# Temporary files
*.tmp
*.bak
*.cache

# Testing / Coverage
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# uv
uv.lock

# Config (generated from .env.example)
config.json
