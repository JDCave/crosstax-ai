{
  "$defs": {
    "DocumentReference": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "maxLength": 36,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "content_hash"
      ],
      "title": "DocumentReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "base_version_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Base Version Id",
      "type": "string"
    },
    "rules": {
      "additionalProperties": true,
      "title": "Rules",
      "type": "object"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/DocumentReference"
      },
      "maxItems": 100,
      "title": "Documents",
      "type": "array"
    },
    "regression_cases": {
      "anyOf": [
        {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 5000,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Regression Cases"
    }
  },
  "required": [
    "schema_version",
    "base_version_id",
    "rules"
  ],
  "title": "RuleBundle",
  "type": "object"
}
