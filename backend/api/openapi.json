{
  "openapi": "3.1.0",
  "info": {
    "title": "CrossTax AI",
    "description": "CRS exemption determination AI system",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/rule-engine/validate": {
      "post": {
        "tags": [
          "rule-engine"
        ],
        "summary": "Validate structured CRS data and return results synchronously",
        "operationId": "validate_api_v1_rule_engine_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request Entity Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditIssue": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "severity": {
            "type": "string",
            "enum": [
              "BLOCKER",
              "WARNING"
            ],
            "title": "Severity"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "severity",
          "message",
          "confidence"
        ],
        "title": "AuditIssue"
      },
      "CRSFormData": {
        "properties": {
          "holder_name": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Holder Name"
          },
          "holder_dob": {
            "type": "string",
            "maxLength": 32,
            "title": "Holder Dob"
          },
          "residence_address": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Residence Address"
          },
          "jurisdiction_code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "title": "Jurisdiction Code"
          },
          "holder_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "INDIVIDUAL",
                  "ENTITY"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Holder Type"
          },
          "tin_type": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Tin Type"
          },
          "tin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tin"
          },
          "has_no_tin": {
            "type": "boolean",
            "title": "Has No Tin"
          },
          "tin_reason_code": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Tin Reason Code"
          },
          "tin_reason_explanation": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Tin Reason Explanation"
          },
          "has_signature": {
            "type": "boolean",
            "title": "Has Signature"
          },
          "signing_date": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Signing Date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "holder_name",
          "holder_dob",
          "residence_address",
          "jurisdiction_code",
          "has_no_tin",
          "has_signature"
        ],
        "title": "CRSFormData",
        "description": "Dates remain strings so invalid signing dates become business issues."
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "ExecutionContext": {
        "properties": {
          "engine_build_id": {
            "type": "string",
            "title": "Engine Build Id"
          },
          "input_fingerprint": {
            "type": "string",
            "title": "Input Fingerprint"
          },
          "policy": {
            "$ref": "#/components/schemas/ValidationPolicy"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "engine_build_id",
          "input_fingerprint",
          "policy"
        ],
        "title": "ExecutionContext"
      },
      "TINCheck": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PASSED",
              "FAILED",
              "NOT_COVERED",
              "NOT_APPLICABLE"
            ],
            "title": "Status"
          },
          "verification_level": {
            "type": "string",
            "enum": [
              "FORMAT_ONLY",
              "CHECKSUM",
              "NONE"
            ],
            "title": "Verification Level"
          },
          "rule_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rule Id"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "algorithm_source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Algorithm Source Url"
          },
          "checks_performed": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Checks Performed",
            "default": []
          },
          "checks_not_performed": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Checks Not Performed",
            "default": []
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "verification_level"
        ],
        "title": "TINCheck"
      },
      "ValidationPolicy": {
        "properties": {
          "today": {
            "type": "string",
            "format": "date",
            "title": "Today"
          },
          "earliest_signing_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Earliest Signing Date"
          },
          "strict_coverage": {
            "type": "boolean",
            "title": "Strict Coverage",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "today"
        ],
        "title": "ValidationPolicy",
        "description": "Caller supplies the business date and any agreed historical cutoff."
      },
      "ValidationRequest": {
        "properties": {
          "form_data": {
            "$ref": "#/components/schemas/CRSFormData"
          },
          "policy": {
            "$ref": "#/components/schemas/ValidationPolicy"
          },
          "indicia_issues": {
            "items": {
              "$ref": "#/components/schemas/AuditIssue"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Indicia Issues"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "form_data",
          "policy"
        ],
        "title": "ValidationRequest"
      },
      "ValidationResponse": {
        "properties": {
          "verdict": {
            "type": "string",
            "enum": [
              "AUTO_PASS",
              "NEED_USER_FIX",
              "MANUAL_TRIAGE"
            ],
            "title": "Verdict"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/AuditIssue"
            },
            "type": "array",
            "title": "Issues"
          },
          "rule_version_id": {
            "type": "string",
            "title": "Rule Version Id"
          },
          "rule_revision": {
            "type": "integer",
            "title": "Rule Revision"
          },
          "checks": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TINCheck"
              },
              {
                "type": "null"
              }
            ]
          },
          "execution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExecutionContext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "verdict",
          "issues",
          "rule_version_id",
          "rule_revision",
          "checks",
          "execution"
        ],
        "title": "ValidationResponse"
      }
    }
  }
}
