{
  "openapi": "3.1.0",
  "info": {
    "title": "CrossTax AI",
    "description": "CRS exemption determination AI system",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/rule-engine/validate": {
      "post": {
        "tags": [
          "rule-engine"
        ],
        "summary": "Validate structured CRS data and return results synchronously",
        "operationId": "validate_api_v1_rule_engine_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request Entity Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditIssue": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "severity": {
            "type": "string",
            "enum": [
              "BLOCKER",
              "WARNING"
            ],
            "title": "Severity"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "severity",
          "message",
          "confidence"
        ],
        "title": "AuditIssue"
      },
      "CRSFormData": {
        "properties": {
          "holder_name": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Holder Name"
          },
          "holder_dob": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Holder Dob"
          },
          "incorporation_date": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Incorporation Date"
          },
          "residence_address": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Residence Address"
          },
          "jurisdiction_code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "title": "Jurisdiction Code"
          },
          "holder_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "INDIVIDUAL",
                  "ENTITY"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Holder Type"
          },
          "tin_type": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Tin Type"
          },
          "tin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tin"
          },
          "has_no_tin": {
            "type": "boolean",
            "title": "Has No Tin"
          },
          "tin_reason_code": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Tin Reason Code"
          },
          "tin_reason_explanation": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Tin Reason Explanation"
          },
          "has_signature": {
            "type": "boolean",
            "title": "Has Signature"
          },
          "signing_date": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Signing Date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "holder_name",
          "residence_address",
          "jurisdiction_code",
          "has_no_tin",
          "has_signature"
        ],
        "title": "CRSFormData",
        "description": "Dates remain strings so invalid signing dates become business issues."
      },
      "CheckItem": {
        "properties": {
          "check_id": {
            "type": "string",
            "title": "Check Id"
          },
          "field": {
            "type": "string",
            "title": "Field"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASSED",
              "FAILED",
              "REVIEW_REQUIRED",
              "NOT_APPLICABLE"
            ],
            "title": "Status"
          },
          "issue_indexes": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Issue Indexes"
          }
        },
        "type": "object",
        "required": [
          "check_id",
          "field",
          "status"
        ],
        "title": "CheckItem"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "ExecutionContext": {
        "properties": {
          "engine_build_id": {
            "type": "string",
            "title": "Engine Build Id"
          },
          "input_fingerprint": {
            "type": "string",
            "title": "Input Fingerprint"
          },
          "policy": {
            "$ref": "#/components/schemas/ValidationPolicy"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "engine_build_id",
          "input_fingerprint",
          "policy"
        ],
        "title": "ExecutionContext"
      },
      "FieldError": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "FieldError"
      },
      "GuidanceAction": {
        "properties": {
          "issue_index": {
            "type": "integer",
            "title": "Issue Index"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "instruction": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Instruction"
          },
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Evidence Refs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "issue_index",
          "field",
          "instruction",
          "evidence_refs"
        ],
        "title": "GuidanceAction"
      },
      "GuidanceResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "NOT_REQUESTED",
              "GENERATED",
              "FALLBACK"
            ],
            "title": "Status"
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "default": ""
          },
          "actions": {
            "items": {
              "$ref": "#/components/schemas/GuidanceAction"
            },
            "type": "array",
            "title": "Actions"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version",
            "default": "remediation-v2"
          },
          "prompt_fingerprint": {
            "type": "string",
            "title": "Prompt Fingerprint"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms",
            "default": 0
          },
          "output_fingerprint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Fingerprint"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "GuidanceResult"
      },
      "IssueOrigin": {
        "properties": {
          "issue_index": {
            "type": "integer",
            "title": "Issue Index"
          },
          "source": {
            "type": "string",
            "enum": [
              "RULE_ENGINE",
              "UPSTREAM"
            ],
            "title": "Source"
          },
          "evidence_ref": {
            "type": "string",
            "title": "Evidence Ref"
          }
        },
        "type": "object",
        "required": [
          "issue_index",
          "source",
          "evidence_ref"
        ],
        "title": "IssueOrigin"
      },
      "MultiResidenceForm": {
        "properties": {
          "holder_name": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Holder Name"
          },
          "holder_type": {
            "type": "string",
            "enum": [
              "INDIVIDUAL",
              "ENTITY"
            ],
            "title": "Holder Type"
          },
          "holder_dob": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Holder Dob"
          },
          "incorporation_date": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Incorporation Date"
          },
          "residence_address": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Residence Address"
          },
          "has_signature": {
            "type": "boolean",
            "title": "Has Signature"
          },
          "signing_date": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Signing Date"
          },
          "tax_residencies": {
            "items": {
              "$ref": "#/components/schemas/TaxResidence"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Tax Residencies"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "holder_name",
          "holder_type",
          "residence_address",
          "has_signature",
          "tax_residencies"
        ],
        "title": "MultiResidenceForm"
      },
      "ResidenceResult": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "jurisdiction_code": {
            "type": "string",
            "title": "Jurisdiction Code"
          },
          "checks": {
            "$ref": "#/components/schemas/TINCheck"
          },
          "issue_indexes": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Issue Indexes"
          }
        },
        "type": "object",
        "required": [
          "index",
          "jurisdiction_code",
          "checks",
          "issue_indexes"
        ],
        "title": "ResidenceResult"
      },
      "ReviewScope": {
        "properties": {
          "statement": {
            "type": "string",
            "title": "Statement",
            "default": "当前已执行检查通过不代表整份 CRS 合规或税收居民身份已经核实"
          },
          "evaluated": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evaluated"
          },
          "not_evaluated": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Not Evaluated"
          }
        },
        "type": "object",
        "title": "ReviewScope"
      },
      "TINCheck": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PASSED",
              "FAILED",
              "NOT_COVERED",
              "NOT_APPLICABLE"
            ],
            "title": "Status"
          },
          "verification_level": {
            "type": "string",
            "enum": [
              "FORMAT_ONLY",
              "CHECKSUM",
              "NONE"
            ],
            "title": "Verification Level"
          },
          "rule_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rule Id"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "algorithm_source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Algorithm Source Url"
          },
          "checks_performed": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Checks Performed",
            "default": []
          },
          "checks_not_performed": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Checks Not Performed",
            "default": []
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "verification_level"
        ],
        "title": "TINCheck"
      },
      "TaxResidence": {
        "properties": {
          "jurisdiction_code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "title": "Jurisdiction Code"
          },
          "tin_type": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Tin Type"
          },
          "tin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tin"
          },
          "has_no_tin": {
            "type": "boolean",
            "title": "Has No Tin"
          },
          "tin_reason_code": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Tin Reason Code"
          },
          "tin_reason_explanation": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Tin Reason Explanation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "jurisdiction_code",
          "has_no_tin"
        ],
        "title": "TaxResidence"
      },
      "ValidationPolicy": {
        "properties": {
          "today": {
            "type": "string",
            "format": "date",
            "title": "Today"
          },
          "earliest_signing_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Earliest Signing Date"
          },
          "strict_coverage": {
            "type": "boolean",
            "title": "Strict Coverage",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "today"
        ],
        "title": "ValidationPolicy",
        "description": "Caller supplies the business date and any agreed historical cutoff."
      },
      "ValidationRequest": {
        "properties": {
          "form_data": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CRSFormData"
              },
              {
                "$ref": "#/components/schemas/MultiResidenceForm"
              }
            ],
            "title": "Form Data"
          },
          "policy": {
            "$ref": "#/components/schemas/ValidationPolicy"
          },
          "indicia_issues": {
            "items": {
              "$ref": "#/components/schemas/AuditIssue"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Indicia Issues"
          },
          "include_guidance": {
            "type": "boolean",
            "title": "Include Guidance",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "form_data",
          "policy"
        ],
        "title": "ValidationRequest"
      },
      "ValidationResponse": {
        "properties": {
          "verdict": {
            "type": "string",
            "enum": [
              "AUTO_PASS",
              "NEED_USER_FIX",
              "MANUAL_TRIAGE"
            ],
            "title": "Verdict"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/AuditIssue"
            },
            "type": "array",
            "title": "Issues"
          },
          "rule_version_id": {
            "type": "string",
            "title": "Rule Version Id"
          },
          "rule_revision": {
            "type": "integer",
            "title": "Rule Revision"
          },
          "checks": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TINCheck"
              },
              {
                "type": "null"
              }
            ]
          },
          "execution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExecutionContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "residence_results": {
            "items": {
              "$ref": "#/components/schemas/ResidenceResult"
            },
            "type": "array",
            "title": "Residence Results"
          },
          "check_items": {
            "items": {
              "$ref": "#/components/schemas/CheckItem"
            },
            "type": "array",
            "title": "Check Items"
          },
          "issue_origins": {
            "items": {
              "$ref": "#/components/schemas/IssueOrigin"
            },
            "type": "array",
            "title": "Issue Origins"
          },
          "review_scope": {
            "$ref": "#/components/schemas/ReviewScope"
          },
          "guidance": {
            "$ref": "#/components/schemas/GuidanceResult"
          }
        },
        "type": "object",
        "required": [
          "verdict",
          "issues",
          "rule_version_id",
          "rule_revision",
          "checks",
          "execution",
          "residence_results",
          "check_items",
          "issue_origins",
          "review_scope",
          "guidance"
        ],
        "title": "ValidationResponse"
      }
    }
  }
}
