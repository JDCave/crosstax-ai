  "components": {
    "schemas": {
      "AuditIssue": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "severity": {
            "type": "string",
            "enum": [
              "BLOCKER",
              "WARNING"
            ],
            "title": "Severity"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "severity",
          "message",
          "confidence"
        ],
        "title": "AuditIssue"
      },
      "CRSFormData": {
        "properties": {
          "holder_name": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Holder Name"
          },
          "holder_dob": {
            "type": "string",
            "maxLength": 32,
            "title": "Holder Dob"
          },
          "residence_address": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Residence Address"
          },
          "jurisdiction_code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "title": "Jurisdiction Code"
          },
          "holder_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "INDIVIDUAL",
                  "ENTITY"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Holder Type"
          },
          "tin_type": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Tin Type"
          },
          "tin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tin"
          },
          "has_no_tin": {
            "type": "boolean",
            "title": "Has No Tin"
          },
          "tin_reason_code": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Tin Reason Code"
          },
          "tin_reason_explanation": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Tin Reason Explanation"
          },
          "has_signature": {
            "type": "boolean",
            "title": "Has Signature"
          },
          "signing_date": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Signing Date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "holder_name",
          "holder_dob",
          "residence_address",
          "jurisdiction_code",
          "has_no_tin",
          "has_signature"
        ],
        "title": "CRSFormData",
        "description": "Dates remain strings so invalid signing dates become business issues."
      },
      "CoverageEntry": {
        "properties": {
          "jurisdiction_code": {
            "type": "string",
            "title": "Jurisdiction Code"
          },
          "holder_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Holder Type"
          },
          "tin_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tin Type"
          },
          "rule_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rule Id"
          },
          "verification_level": {
            "type": "string",
            "title": "Verification Level"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "algorithm_source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Algorithm Source Url"
          }
        },
        "type": "object",
        "required": [
          "jurisdiction_code",
          "holder_type",
          "tin_type",
          "rule_id",
          "verification_level",
          "source_url",
          "algorithm_source_url"
        ],
        "title": "CoverageEntry"
      },
      "CoverageResponse": {
        "properties": {
          "rule_version_id": {
            "type": "string",
            "title": "Rule Version Id"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "rules": {
            "items": {
              "$ref": "#/components/schemas/CoverageEntry"
            },
            "type": "array",
            "title": "Rules"
          }
        },
        "type": "object",
        "required": [
          "rule_version_id",
          "revision",
          "rules"
        ],
        "title": "CoverageResponse"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "ExecutionContext": {
        "properties": {
          "engine_build_id": {
            "type": "string",
            "title": "Engine Build Id"
          },
          "input_fingerprint": {
            "type": "string",
            "title": "Input Fingerprint"
          },
          "policy": {
            "$ref": "#/components/schemas/ValidationPolicy"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "engine_build_id",
          "input_fingerprint",
          "policy"
        ],
        "title": "ExecutionContext"
      },
      "RuleVersionResponse": {
        "properties": {
          "rule_version_id": {
            "type": "string",
            "title": "Rule Version Id"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "rule_count": {
            "type": "integer",
            "title": "Rule Count"
          }
        },
        "type": "object",
        "required": [
          "rule_version_id",
          "revision",
          "rule_count"
        ],
        "title": "RuleVersionResponse"
      },
      "TINCheck": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PASSED",
              "FAILED",
              "NOT_COVERED",
              "NOT_APPLICABLE"
            ],
            "title": "Status"
          },
          "verification_level": {
            "type": "string",
            "enum": [
              "FORMAT_ONLY",
              "CHECKSUM",
              "NONE"
            ],
            "title": "Verification Level"
          },
          "rule_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rule Id"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "algorithm_source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Algorithm Source Url"
          },
          "checks_performed": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Checks Performed",
            "default": []
          },
          "checks_not_performed": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Checks Not Performed",
            "default": []
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "verification_level"
        ],
        "title": "TINCheck"
      },
      "ValidationPolicy": {
        "properties": {
          "today": {
            "type": "string",
            "format": "date",
            "title": "Today"
          },
          "earliest_signing_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Earliest Signing Date"
          },
          "strict_coverage": {
            "type": "boolean",
            "title": "Strict Coverage",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "today"
        ],
        "title": "ValidationPolicy",
        "description": "Caller supplies the business date and any agreed historical cutoff."
      },
      "ValidationRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$",
            "title": "Session Id"
          },
          "form_data": {
            "$ref": "#/components/schemas/CRSFormData"
          },
          "policy": {
            "$ref": "#/components/schemas/ValidationPolicy"
          },
          "indicia_issues": {
            "items": {
              "$ref": "#/components/schemas/AuditIssue"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Indicia Issues"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "form_data",
          "policy"
        ],
        "title": "ValidationRequest"
      },
      "ValidationResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "result": {
            "$ref": "#/components/schemas/ValidationResult"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "result"
        ],
        "title": "ValidationResponse"
      },
      "ValidationResult": {
        "properties": {
          "rule_version_id": {
            "type": "string",
            "title": "Rule Version Id"
          },
          "rule_revision": {
            "type": "integer",
            "title": "Rule Revision"
          },
          "execution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExecutionContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "tin_check": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TINCheck"
              },
              {
                "type": "null"
              }
            ]
          },
          "form_issues": {
            "items": {
              "$ref": "#/components/schemas/AuditIssue"
            },
            "type": "array",
            "title": "Form Issues"
          },
          "indicia_issues": {
            "items": {
              "$ref": "#/components/schemas/AuditIssue"
            },
            "type": "array",
            "title": "Indicia Issues"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "AUTO_PASS",
              "NEED_USER_FIX",
              "MANUAL_TRIAGE"
            ],
            "title": "Verdict"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "rule_version_id",
          "rule_revision",
          "form_issues",
          "indicia_issues",
          "verdict"
        ],
        "title": "ValidationResult"
      }
    }
  }
}
